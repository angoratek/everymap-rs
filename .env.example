# EveryMap-RS Test Credentials
# Copy this file to .env and fill in your API keys.
# These are used by integration/CLI tests that hit live APIs.
# Never commit .env to version control.

# HERE Technologies
EVERYMAP_HERE_API_KEY=

# Google Maps Platform
EVERYMAP_GOOGLE_API_KEY=

# TomTom
EVERYMAP_TOMTOM_API_KEY=

# MapBox
EVERYMAP_MAPBOX_API_KEY=

# Radar
EVERYMAP_RADAR_API_KEY=

# Fallback (used if provider-specific key is not set)
EVERYMAP_API_KEY=